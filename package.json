{
  "name": "@portfolio/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio monorepo (pnpm workspaces).",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @portfolio/web dev",
    "dev:kill": "node scripts/kill-dev-server.mjs",
    "build": "pnpm -r --if-present build",
    "preview": "pnpm --filter @portfolio/web preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run test && pnpm run build",
    "clean": "pnpm -r --if-present clean && rm -rf coverage node_modules/.vite"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "jiti": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
