{
  "name": "@portfolio/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio monorepo (pnpm workspaces).",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "^26.3.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "jiti": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
