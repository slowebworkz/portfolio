{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Base config shared by all packages. Each package extends this file
       and sets its own `rootDir`, `outDir`, and `include`. */
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,

    /* Relative imports name the real source file (`./x.ts`); tsc rewrites the
       extension on emit. Keeps import specifiers consistent across the repo. */
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "skipLibCheck": true
  }
}
